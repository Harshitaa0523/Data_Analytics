      "source": [
        "# function for ploting the histogram for numerical features\n",
        "def numeric_feature_hist(df, numerical_feature):\n",
        "  # Calculate statistics for the numerical feature\n",
        "  mean_value = df[numerical_feature].mean()\n",
        "  median_value = df[numerical_feature].median()\n",
        "  std_value = df[numerical_feature].std()\n",
        "  min_value = df[numerical_feature].min()\n",
        "  max_value = df[numerical_feature].max()\n",
        "\n",
        "  # Set a Seaborn style for a cleaner and more attractive plot\n",
        "  sns.set(style=\"whitegrid\")\n",
        "\n",
        "  # Create a figure with two subplots (1 row, 2 columns)\n",
        "  fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
        "\n",
        "  # Plot the histogram on the first subplot\n",
        "  sns.histplot(df[numerical_feature], bins=30, kde=True, color='skyblue', edgecolor='black', alpha=0.7, ax=axes[0])\n",
        "  axes[0].set_title(f'Distribution of {numerical_feature}', fontsize=18, fontweight='bold', color='darkblue')\n",
        "  axes[0].set_xlabel(numerical_feature, fontsize=14, color='darkblue')\n",
        "  axes[0].set_ylabel('Frequency', fontsize=14, color='darkblue')\n",
        "  axes[0].grid(True, linestyle='--', alpha=0.6)\n",
        "\n",
        "  # Plot the boxplot on the second subplot\n",
        "  sns.boxplot(x=df[numerical_feature], color='lightgreen', ax=axes[1])\n",
        "  axes[1].set_title(f'{numerical_feature} Box Plot', fontsize=18, fontweight='bold', color='darkblue')\n",
        "  axes[1].set_xlabel(numerical_feature, fontsize=14, color='darkblue')\n",
        "  axes[1].grid(True, linestyle='--', alpha=0.6)\n",
        "\n",
        "  # Add the statistics text to the histogram plot\n",
        "  statistics_text = (\n",
        "      f'Mean: {mean_value:.2f}\\n'\n",
        "      f'Median: {median_value:.2f}\\n'\n",
        "      f'Standard Deviation: {std_value:.2f}\\n'\n",
        "      f'Min: {min_value:.2f}\\n'\n",
        "      f'Max: {max_value:.2f}'\n",
        "  )\n",
        "\n",
        "  # Position the statistics on the first subplot (histogram)\n",
        "  axes[0].text(0.95, 0.95, statistics_text, ha='right', va='top', transform=axes[0].transAxes,\n",
        "              fontsize=12, color='darkblue', bbox=dict(facecolor='white', edgecolor='darkblue', boxstyle='round,pad=1'))\n",
        "\n",
        "  # Adjust the layout for better spacing\n",
        "  plt.tight_layout()\n",
        "\n",
        "  # Show the plot\n",
        "  plt.show()\n"
      ]
